{% liquid
  assign lineup = settings.chairs | default: collections['massage-chairs']
  assign chairs = section.settings.products | default: lineup.products
  assign is_page = false
  if request.page_type == 'page'
    assign is_page = true
  endif
%}
{% if chairs.size > 0 %}
{% render 'native-comparison', chairs: chairs, is_page: is_page, comparison_id: 'store-comparison' %}{% elsif is_page %}<section class="wrap slab"><h1>{{ page.title | escape }}</h1><p>{{ 'arbor.there_are_currently_no_chairs_to_compare' | t }}</p></section>
{% elsif request.design_mode %}<p class="wrap">{{ 'arbor.select_up_to_three_comparison_products' | t }}</p>{% endif %}

{% schema %}
{
  "name": "Compare chairs",
  "settings": [
    {
      "type": "product_list",
      "id": "products",
      "label": "Comparison products",
      "limit": 3
    }
  ],
  "presets": [
    {
      "name": "Compare chairs"
    }
  ]
}
{% endschema %}
