{% liquid
  assign chair = section.settings.chair | default: all_products['real-relax-ps5200']
  assign finish = chair.variants | where: 'option1', 'Khaki' | first
  assign room = finish.metafields.chair.gallery.value | first
  assign photo = section.settings.image | default: room.preview_image
  assign lineup = settings.chairs | default: collections['massage-chairs']
  assign browse = section.settings.browse
  if browse == blank and lineup.products_count > 0
    assign browse = lineup.url
  endif
  assign browse = browse | default: '#chair-guide'
  assign compare = section.settings.compare | default: settings.compare_page.url
  if compare == blank
    if lineup.products_count > 0
      assign compare = '#store-comparison'
    else
      assign compare = '#chair-comparison'
    endif
  endif
  assign guide_photo = false
  if photo == blank and section.settings.chair == blank
    assign guide_photo = true
    assign guide_chair_url = finish.url | default: chair.url
    assign count = lineup.products_count | default: 0
    if guide_chair_url == blank and count == 0
      assign guide_chair_url = '#product-linden'
    endif
  endif
%}
<section class="hero wrap{% unless photo or guide_photo %} text-hero{% endunless %}">
  <div class="hero-copy">
    <h1>{% if section.settings.heading == 'A quieter evening.' %}{{ 'arbor.a_quieter' | t }} <br><em>{{ 'arbor.evening' | t }}</em>{% else %}{{ section.settings.heading | escape }}{% endif %}</h1>
    <p>{% if lineup.products_count == 3 %}Explore three Real Relax massage chairs, selected for how they feel and how they fit your home.{% else %}Explore Real Relax massage chairs, selected for how they feel and how they fit your home.{% endif %}</p>
    <div class="actions">{% if browse != blank %}<a class="button" href="{{ browse }}">{{ 'arbor.explore_the_chairs' | t }} <span aria-hidden="true">→</span></a>{% endif %}
      {% if compare != blank %}<a class="under" href="{{ compare }}">{{ 'arbor.compare_chairs' | t }}</a>{% endif %}</div>
  </div>
  {% if photo %}<figure class="hero-photo">{% render 'chair-image', image: photo, label: chair.title, eager: true, sizes: '(min-width: 760px) 56vw, 100vw' %}
    {% if finish and section.settings.image == blank %}<figcaption><a href="{{ finish.url }}">{% render 'chair-name', chair: chair %} <span> / </span> {{ finish.option1 | escape }}</a></figcaption>{% endif %}
  </figure>
  {% elsif guide_photo %}
    <figure class="hero-photo">
      <img src="{{ 'guide-ps5200-khaki-lifestyle-1280.webp' | asset_url }}"
           srcset="{{ 'guide-ps5200-khaki-lifestyle-720.webp' | asset_url }} 720w, {{ 'guide-ps5200-khaki-lifestyle-1280.webp' | asset_url }} 1280w"
           sizes="(min-width: 760px) 56vw, 100vw" width="1280" height="1280" fetchpriority="high"
           alt="Linden massage chair in Khaki in a furnished living room">
      <figcaption>
        {% if guide_chair_url != blank %}<a href="{{ guide_chair_url }}">Linden / Khaki</a>
        {% else %}<span class="guide-caption">Linden / Khaki</span>{% endif %}
      </figcaption>
    </figure>
  {% elsif request.design_mode %}<p>{{ 'arbor.choose_the_lead_photograph_or_assign_the_khaki' | t }}</p>{% endif %}
</section>

{% schema %}
{
  "name": "Lead chair",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A quieter evening."
    },
    {
      "type": "product",
      "id": "chair",
      "label": "Featured chair"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Replace room photograph"
    },
    {
      "type": "url",
      "id": "browse",
      "label": "Explore link override"
    },
    {
      "type": "url",
      "id": "compare",
      "label": "Comparison link override"
    }
  ],
  "presets": [
    {
      "name": "Lead chair"
    }
  ]
}
{% endschema %}
