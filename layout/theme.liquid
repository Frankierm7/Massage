<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% render 'meta-tags' %}
    <meta name="theme-color" content="#f6f2ea">
    {{ 'instrument-serif-latin-400-normal.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {{ 'arbor.css' | asset_url | stylesheet_tag }}
    {{ 'catalog-cart.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'catalog-cart.js' | asset_url }}" defer></script>
    <script src="{{ 'arbor.js' | asset_url }}" defer></script>
    {% if request.page_type == 'index' and template.suffix == blank %}
      {{ 'product-detail.css' | asset_url | stylesheet_tag }}
      <script src="{{ 'product-detail.js' | asset_url }}" defer></script>
      {{ 'standalone-contact.css' | asset_url | stylesheet_tag }}
      <script src="{{ 'standalone-contact.js' | asset_url }}" defer></script>
    {% endif %}
    {{ content_for_header }}
  </head>
  <body>
    <a class="skip" href="#main">{{ 'arbor.skip_to_content' | t }}</a>
    {% sections 'header-group' %}
    <main id="main" tabindex="-1">
      {{ content_for_layout }}
      {% if request.page_type == 'index' and template.suffix == blank %}{% render 'standalone-contact' %}{% endif %}
    </main>
    {% sections 'footer-group' %}
    {% render 'catalog-bag' %}
  </body>
</html>
