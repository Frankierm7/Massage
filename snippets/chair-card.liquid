{% capture branded_name %}{% render 'chair-name', chair: chair, plain: true %}{% endcapture %}
{% assign branded_name = branded_name | strip %}
<article class="chair-card">
  <a href="{{ chair.url }}" class="card-link">
    {% assign photo = chair.selected_or_first_available_variant.featured_image | default: chair.featured_image %}
    {% if photo %}
      <div class="studio">{% render 'chair-image', image: photo, label: branded_name, sizes: '(min-width: 880px) 32vw, (min-width: 480px) 46vw, 90vw' %}</div>
    {% else %}
      {% capture stem %}{% render 'catalog-photo-stem', chair: chair, variant: chair.selected_or_first_available_variant %}{% endcapture %}
      {% if stem != blank %}
        <div class="studio"><img src="{{ stem | append: '-studio-760.webp' | asset_url }}" width="760" height="760" loading="lazy" alt="{{ branded_name | escape }} in {{ chair.selected_or_first_available_variant.option1 | escape }}"></div>
      {% endif %}
    {% endif %}
    <div class="card-heading">
        {% if collection_heading %}<h2>{{ branded_name | escape }}</h2>{% else %}<h3>{{ branded_name | escape }}</h3>{% endif %}
      <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 16 16 4M5 4h11v11"/></svg>
    </div>
  </a>
  {% if chair.metafields.chair.highlight.value %}<p>{{ chair.metafields.chair.highlight.value | escape }}</p>{% endif %}
  <div class="card-meta"><span>{% if chair.price_varies %}From {% endif %}{{ chair.price | money_with_currency }}</span>
    {% unless chair.available %}<span>{{ 'arbor.sold_out' | t }}</span>{% endunless %}
  </div>
  {% if chair.available %}
    <div class="card-purchase" aria-label="Purchase {{ branded_name | escape }}">
      {% for variant in chair.variants %}
        {% if variant.available %}
          <form class="buy-form" method="post" action="{{ routes.cart_add_url }}" data-cart-url="{{ routes.cart_url }}">
            <input type="hidden" name="id" value="{{ variant.id }}">
            <input type="hidden" name="quantity" value="{{ variant.quantity_rule.min | default: 1 }}">
            <input type="hidden" name="return_to" value="{{ routes.cart_url }}">
            <button class="button" type="submit">{% if variant.title == 'Default Title' %}Add to bag{% else %}Buy {{ variant.title | escape }}{% endif %}</button>
            <p class="form-error" role="alert" tabindex="-1"></p>
          </form>
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}
</article>
