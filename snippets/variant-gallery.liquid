{% assign hero = variant.featured_image %}
{% assign gallery = variant.metafields.chair.gallery.value %}
{% capture stem %}{% render 'catalog-photo-stem', chair: chair, variant: variant %}{% endcapture %}
{% if stem != blank %}
  {% capture model_name %}{% render 'chair-name', chair: chair, plain: true %}{% endcapture %}
  {% assign label = model_name | strip | append: ' in ' | append: variant.option1 %}
{% endif %}
{% if gallery == blank %}
  {% if stem != blank %}
    {% assign studio = stem | append: '-studio-760.webp' %}
  {% elsif hero == blank %}
    {% assign gallery = chair.images %}
  {% endif %}
{% endif %}
{% if hero or gallery != blank or studio %}
  {% assign first = gallery | first %}
  {% assign primary = hero | default: first.preview_image | default: first %}
  <div class="gallery" data-gallery>
    {% if primary != blank %}{% assign full_url = primary | image_url: width: 2000 %}{% else %}{% assign full_url = studio | asset_url %}{% endif %}
    <a class="gallery-main studio" href="{{ full_url | escape }}" aria-label="Enlarge {{ variant.title | escape }} photograph">
      {% if primary != blank %}
        {% render 'chair-image', image: primary, label: variant.title, sizes: '(min-width: 760px) 55vw, 100vw', eager: true %}
      {% else %}
        <img src="{{ studio | asset_url }}" width="760" height="760" alt="{{ label | escape }}, studio view" fetchpriority="high">
      {% endif %}
      <span class="zoom-mark" aria-hidden="true">＋</span>
    </a>
    {% if gallery != blank or stem != blank %}<div class="thumbs" aria-label="{{ 'arbor.photographs' | t | escape }}">
      {% if hero %}{% render 'gallery-thumb', photo: hero, active: true, label: variant.title %}{% endif %}
      {% if studio and hero == blank %}{% render 'catalog-gallery-thumb', filename: studio, width: 760, description: label, active: true %}{% endif %}
      {% for media in gallery %}{% assign image = media.preview_image | default: media %}{% if image %}
        {% assign active = false %}{% if hero == blank and forloop.first %}{% assign active = true %}{% endif %}
        {% render 'gallery-thumb', photo: image, active: active, label: variant.title %}
      {% endif %}{% endfor %}
      {% if studio %}
        {% assign room = stem | append: '-lifestyle-720.webp' %}
        {% assign track = stem | append: '-track-900.webp' %}
        {% assign room_alt = label | append: ', in a furnished room' %}
        {% assign track_alt = label | append: ', roller-track illustration' %}
        {% render 'catalog-gallery-thumb', filename: room, width: 720, description: room_alt %}
        {% render 'catalog-gallery-thumb', filename: track, width: 900, description: track_alt %}
      {% endif %}
      {% if stem != blank %}
        {% assign extra_views = 'programs,recline,details' | split: ',' %}
        {% for view in extra_views %}
          {% assign filename = stem | append: '-' | append: view | append: '-1000.webp' %}
          {% assign description = label | append: ', ' | append: view %}
          {% render 'catalog-gallery-thumb', filename: filename, width: 1000, description: description %}
        {% endfor %}
      {% endif %}
    </div>{% endif %}
    <dialog aria-label="{{ 'arbor.enlarged_chair_photograph' | t | escape }}"><button type="button" data-close>{{ 'arbor.close' | t }}</button><div data-zoom></div></dialog>
  </div>
{% endif %}
