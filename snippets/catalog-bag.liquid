<dialog id="shopping-bag" class="catalog-bag" aria-labelledby="catalog-bag-heading">
  <header><h2 id="catalog-bag-heading">Your bag</h2><button type="button" data-bag-close>Close</button></header>
  <p data-bag-empty>Your bag is empty.</p>
  <ul data-bag-lines></ul>
  <div data-bag-totals hidden>
    <p class="bag-subtotal">Subtotal <strong data-bag-subtotal></strong></p>
    <p class="bag-checkout-note">Checkout requires a connected Shopify store.</p>
    <a class="under" href="#contact-us" data-contact-link data-bag-inquiry>Contact us about this bag</a>
  </div>
  <p class="sr" role="status" aria-live="polite" data-bag-status></p>
</dialog>
