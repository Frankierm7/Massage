<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width,initial-scale=1">

{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: product.description | default: collection.description | default: page.content | strip_html | strip | truncate: 160
  if og_description == blank
    assign og_description = page_title | append: " – " | append: shop.name
  endif

  if request.page_type == 'product'
    assign og_type = 'product'
    capture display_name
      render 'chair-name', chair: product, plain: true
    endcapture
    if page_title == product.title
      assign og_title = display_name
    else
      capture og_title
        render 'chair-alt', text: og_title
      endcapture
    endif
    capture og_description
      render 'chair-alt', text: og_description
    endcapture
  elsif request.page_type == 'index' and template.suffix == 'contact'
    assign og_title = 'contact_us.title' | t
    assign og_description = 'contact_us.intro' | t
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta
  property="og:site_name"
  content="{{ shop.name | escape }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- if page_image -%}
  <meta
    property="og:image"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:width"
    content="{{ page_image.width }}"
  >
  <meta
    property="og:image:height"
    content="{{ page_image.height }}"
  >
{%- endif -%}

{%- if request.page_type == 'product' -%}
  {%- assign native_json_title = product.title | json -%}
  {%- assign display_json_title = display_name | json -%}
  <script type="application/ld+json">
    {{ product | structured_data | replace: native_json_title, display_json_title }}
  </script>

  <meta
    property="og:price:amount"
    content="{{ product.selected_or_first_available_variant.price | divided_by: 100.0 }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>

<title>
  {{ og_title | escape }}
  {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
  {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
  {%- unless og_title contains shop.name %} &ndash; {{ shop.name | escape }}{% endunless -%}
</title>

<link
  rel="canonical"
  href="{{ canonical_url }}"
>

{% if og_description != blank %}
  <meta
    name="description"
    content="{{ og_description | escape }}"
  >
{% endif %}
