{%- comment -%}Verified specifications for the three launch chairs. Merchant-supplied fields take precedence.{%- endcomment -%}
{%- liquid
  assign value = chair.metafields.chair[key].value
  if value != blank
    if key == 'features'
      for feature in value
        echo '<li>'
        echo feature | escape
        echo '</li>'
      endfor
    else
      echo value
    endif
  else
    case chair.handle
      when 'real-relax-favor-27', 'alder', 'alder-massage-chair'
        case key
          when 'mechanism'
            echo '3D'
          when 'track'
            echo 'SL'
          when 'programs'
            echo '16'
          when 'positions'
            echo '2'
          when 'controls'
            echo '7-inch touchscreen'
          when 'features'
            echo '<li>3D rollers on an SL track</li><li>16 automatic programs</li><li>Two zero-gravity positions</li><li>7-inch touchscreen</li><li>Lumbar heat</li><li>26 air cells</li><li>Foot rollers and extendable footrest</li><li>Bluetooth audio and USB charging</li>'
          when 'manual'
            echo 'https://cdn.shopify.com/s/files/1/0665/9493/0917/files/real_relax_Favor-27_user_manual.pdf?v=1789122158'
          when 'power_w'
            echo '80'
          when 'supply'
            echo '110 V / 60 Hz'
          when 'upright_depth'
            echo '57.1'
          when 'upright_width'
            echo '29.1'
          when 'upright_height'
            echo '42.1'
          when 'reclined_depth'
            echo '66.1'
          when 'reclined_width'
            echo '29.1'
          when 'reclined_height'
            echo '35.4'
          when 'carton_depth'
            echo '46.5'
          when 'carton_width'
            echo '29.5'
          when 'carton_height'
            echo '43.7'
        endcase
      when 'real-relax-ps5200', 'linden', 'linden-massage-chair'
        case key
          when 'mechanism'
            echo '4D'
          when 'track'
            echo 'SL'
          when 'programs'
            echo '20'
          when 'positions'
            echo '2'
          when 'controls'
            echo 'Five roller intensity levels and five air pressure levels'
          when 'features'
            echo '<li>4D rollers on an SL track</li><li>20 automatic programs</li><li>Two zero-gravity positions</li><li>Five roller intensity levels and five air pressure levels</li><li>30 air cells</li><li>Shoulder detection</li><li>Lumbar heat and foot rollers</li><li>Touch controls and wireless charging</li>'
          when 'manual'
            echo 'https://cdn.shopify.com/s/files/1/0665/9493/0917/files/real_relax_PS5200_user_manual.pdf?v=1755509321'
          when 'power_w'
            echo '85'
          when 'supply'
            echo '110 V / 60 Hz'
          when 'upright_depth'
            echo '57.5'
          when 'upright_width'
            echo '29.1'
          when 'upright_height'
            echo '44.5'
          when 'reclined_depth'
            echo '70.1'
          when 'reclined_width'
            echo '29.1'
          when 'reclined_height'
            echo '38.6'
          when 'carton_depth'
            echo '50.4'
          when 'carton_width'
            echo '29.9'
          when 'carton_height'
            echo '47.2'
          when 'weight_lb'
            echo '174.2'
        endcase
      when 'real-relax-ps6500', 'sequoia', 'sequoia-massage-chair'
        case key
          when 'mechanism'
            echo '4D'
          when 'track'
            echo 'Long SL'
          when 'programs'
            echo '27'
          when 'positions'
            echo '3'
          when 'controls'
            echo '7-inch touchscreen, voice control and favorite settings'
          when 'features'
            echo '<li>4D rollers on a long SL track</li><li>27 automatic programs</li><li>Three zero-gravity positions</li><li>7-inch touchscreen and voice control</li><li>Favorite settings</li><li>28 air cells</li><li>Lumbar heat and foot rollers</li><li>25 ambient sounds</li><li>Bluetooth audio and wireless charging</li>'
          when 'manual'
            echo 'https://cdn.shopify.com/s/files/1/0023/2525/0115/files/PS6500__20230516-__compressed.pdf?v=1760938058'
          when 'power_w'
            echo '110'
          when 'supply'
            echo '110–120 V / 60 Hz'
          when 'upright_depth'
            echo '61.81'
          when 'upright_width'
            echo '30.71'
          when 'upright_height'
            echo '48.82'
          when 'reclined_depth'
            echo '74.02'
          when 'reclined_width'
            echo '30.71'
          when 'reclined_height'
            echo '38.98'
          when 'carton_depth'
            echo '58.46'
          when 'carton_width'
            echo '31.89'
          when 'carton_height'
            echo '50.2'
          when 'weight_lb'
            echo '205'
        endcase
    endcase
  endif
-%}
